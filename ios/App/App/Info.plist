	<!--
	    ADHCC Security Compliance — SSL Certificate Pinning (Finding 3, CVSS 5.9)
	    OWASP MASVS-NETWORK-2 / MSTG-NETWORK-3 / CWE-295
	    PCI-DSS 4.1–4.2 / HIPAA 164.312(e) / GDPR Art-32

	    Domain       : 247tech.net (includeSubdomains)
	    Issuer       : Let's Encrypt E7 (intermediate CA)
	    Leaf cert    : CN=247tech.net  notAfter=2026-05-27
	    Pins generated: May 2026

	    PIN RENEWAL:
	      Let's Encrypt rotates leaf certs every 90 days.
	      The CA pin (y7xVm0TV...) survives leaf renewals automatically.
	      Regenerate when Let's Encrypt changes E7 intermediate CA.
	      Script: ./scripts/generate-cert-pins.sh 247tech.net
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSPinnedDomains</key>
		<dict>
			<key>247tech.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<!-- Intermediate CA pin — stable across 90-day leaf renewals -->
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>y7xVm0TVJNahMr2sZydE2jQH8SquXV9yLF9seROHHHU=</string>
					</dict>
				</array>
				<!-- Leaf cert pin — CN=247tech.net, Let's Encrypt E7, expires 2026-05-27 -->
				<key>NSPinnedLeafIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>ytfBlJ7pDcS/wF7PIxKWfh32t7HESGQ5evSZQnSzJV4=</string>
					</dict>
				</array>
			</dict>
		</dict>
	</dict>

</dict>
</plist>
